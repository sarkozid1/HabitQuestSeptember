<?xml version="1.0" encoding="utf-8"?>
<!-- Csak a widgetválasztó előnézete (statikus minta; a valódi tartalmat a HabitWidgets tölti) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/karakter_ikon"
        android:src="@drawable/role_playing"
        android:tint="@color/gold_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="serif"
        android:text="@string/widget_preview_level"
        android:textColor="@color/ink_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/xp_progress_bar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/widget_preview_today"
        android:textColor="@color/ink_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
