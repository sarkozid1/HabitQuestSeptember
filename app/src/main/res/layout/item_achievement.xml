<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/achievement_background"
    android:elevation="3dp">

    <!-- Ikon -->
    <ImageView
        android:id="@+id/achievementIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/achievement_lock"
        android:layout_marginEnd="12dp"/>

    <!-- Szöveges rész -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/achievementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Achievement címe"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/ink_primary"/>

        <TextView
            android:id="@+id/achievementDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rövid leírás az achievementhez"
            android:textSize="13sp"
            android:textColor="@color/ink_secondary"/>
    </LinearLayout>
</LinearLayout>
