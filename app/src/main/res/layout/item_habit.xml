<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    card_view:cardBackgroundColor="@color/glass_parchment"
    card_view:cardCornerRadius="20dp"
    card_view:cardElevation="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:orientation="vertical">

        <!-- Fejsor: név + napi számláló chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/habitName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="Szokás neve"
                android:textColor="@color/ink_primary"
                android:textSize="19sp"
                android:letterSpacing="-0.01"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/completionsTodayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/count_badge_bg"
                android:gravity="center"
                android:minWidth="30dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text=""
                android:textColor="@color/ink_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Leírás -->
        <TextView
            android:id="@+id/habitDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Leírás..."
            android:textColor="@color/ink_secondary"
            android:lineSpacingExtra="2sp"
            android:textSize="14sp" />

        <!-- Streak kijelző -->
        <TextView
            android:id="@+id/habitStreakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/gold_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
