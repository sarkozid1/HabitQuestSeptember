<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/widgetItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetItemCheck"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_check_open"
        android:gravity="center"
        android:textColor="@color/ink_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
