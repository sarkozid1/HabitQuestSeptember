<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    card_view:cardBackgroundColor="@color/glass_parchment"
    card_view:cardCornerRadius="20dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Emoji ikon -->
        <TextView
            android:id="@+id/shopItemEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/glass_chip_bg"
            android:gravity="center"
            android:text="🧪"
            android:textSize="24sp" />

        <!-- Név + leírás -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shopItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Tárgy neve"
                android:textColor="@color/ink_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shopItemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Leírás..."
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Vásárlás gomb -->
        <Button
            android:id="@+id/shopItemBuyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/button_pill_oncard"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:paddingHorizontal="14dp"
            android:text="💰 0"
            android:textColor="@color/ink_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
