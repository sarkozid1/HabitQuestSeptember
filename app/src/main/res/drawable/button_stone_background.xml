<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lenyomott állapot -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#8A8A8A"
                android:endColor="#5C5C5C"
                android:angle="270" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#4D3A1F" />
        </shape>
    </item>

    <!-- Normál állapot -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#B7B7B7"
                android:endColor="#8F8F8F"
                android:angle="270" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#4D3A1F" />
        </shape>
    </item>
</selector>
