<?xml version="1.0" encoding="utf-8"?>
<!-- Kártyán ülő gomb: kicsit sötétebb, hogy elváljon a kártya pergamen hátterétől -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D6C7A0" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/glass_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_parchment_dark" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
