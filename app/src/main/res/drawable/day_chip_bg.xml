<?xml version="1.0" encoding="utf-8"?>
<!-- Hét napja választó "pecsét": kijelölve arany, egyébként pergamen -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/gold_accent" />
            <stroke android:width="1dp" android:color="@color/glass_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFBF0" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
