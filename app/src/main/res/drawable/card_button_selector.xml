<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#403D2F"/>
            <corners android:radius="20dp"/>
            <stroke android:color="@color/gold_bright" android:width="2dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_parchment"/>
            <corners android:radius="20dp"/>
            <stroke android:color="@color/glass_border" android:width="1dp"/>
        </shape>
    </item>
</selector>
