<?xml version="1.0" encoding="utf-8"?>
<!-- Kasztkártya: kijelölve arany keret -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_parchment_light" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="@color/gold_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_parchment_dark" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/gold_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_parchment" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
