<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 🌙 Alap app téma – sötét fantasy hangulat -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Fő színek -->
        <item name="colorPrimary">#3F0071</item>          <!-- mély lila -->
        <item name="colorPrimaryDark">#240046</item>      <!-- sötétlila -->
        <item name="colorAccent">#FFD700</item>           <!-- arany -->
        <!-- Szövegszínek és háttér -->
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:windowBackground">#1E1E1E</item>

    </style>

    <!-- ✨ Dialógus animáció (beúszás) -->
    <style name="DialogFadeAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_in</item>
    </style>



    <!-- 💫 Gombstílus (pl. "Új szokás" gomb) -->
    <style name="RpgButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">#3F0071</item>
        <item name="android:textColor">#FFD700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 🗓️ Hét napja "pecsét" az ütemezés választóban -->
    <style name="DayChip">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/day_chip_bg</item>
        <item name="android:textColor">@color/day_chip_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 🗓️ Ütemezés típus választó -->
    <style name="ScheduleRadio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textColor">#3A2C1A</item>
        <item name="android:textSize">14sp</item>
        <item name="buttonTint">@color/glass_border_strong</item>
    </style>

</resources>
