<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+) mentési szabályok.
   - cloud-backup: automatikus Google-mentés (Google One / Drive)
   - device-transfer: adatátvitel új telefonra (kábeles / vezeték nélküli átvitel)
   Mindkettő csak a HabitQuest SharedPreferences fájlját viszi át; a WorkManager
   adatbázisát nem (az emlékeztetőket az app induláskor újraütemezi).
   Lásd: https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="habitquest_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="habitquest_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
