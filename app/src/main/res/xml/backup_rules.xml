<?xml version="1.0" encoding="utf-8"?>
<!--
   Automatikus Google-mentés (Auto Backup) – Android 11 (API 30) és régebbi.
   Android 12+ esetén a data_extraction_rules.xml érvényes.
   Csak a HabitQuest SharedPreferences fájlja kerül a mentésbe (karakter, szokások,
   achievementek, beállítások). A WorkManager belső adatbázisa NEM: az emlékeztetőket
   visszaállítás után az app induláskor újraütemezi.
   Lásd: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="sharedpref" path="habitquest_prefs.xml" />
</full-backup-content>
